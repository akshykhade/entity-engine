{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@crud-engine/auth": "workspace:*",
    "@crud-engine/db": "workspace:*",
    "@crud-engine/domains": "workspace:*",
    "@crud-engine/engine": "workspace:*",
    "@crud-engine/permissions": "workspace:*",
    "@crud-engine/env": "workspace:*",
    "@fastify/cors": "^11.0.1",
    "@fastify/swagger": "^9.7.0",
    "@scalar/fastify-api-reference": "^1.58.0",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.3.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@crud-engine/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.21.9",
    "typescript": "catalog:"
  }
}
